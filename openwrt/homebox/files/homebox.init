#!/bin/sh /etc/rc.common

START=90
STOP=10
USE_PROCD=1
PROG="/usr/bin/homebox"

append_arg() {
	local section="$1"
	local option="$2"
	local flag="$3"
	local value

	config_get value "$section" "$option"
	[ -n "$value" ] && procd_append_param command "$flag" "$value"
}

start_instance() {
	local section="$1"
	local enabled
	local respawn

	config_get_bool enabled "$section" enabled 1
	[ "$enabled" -eq 1 ] || return 0

	config_get_bool respawn "$section" respawn 1

	procd_open_instance "$section"
	procd_set_param command "$PROG"
	procd_append_param command serve
	append_arg "$section" host "--host"
	append_arg "$section" port "--port"
	append_arg "$section" workers "--workers"
	append_arg "$section" max_connections "--max-connections"
	append_arg "$section" keep_alive_secs "--keep-alive-secs"
	[ "$respawn" -eq 1 ] && procd_set_param respawn
	procd_set_param user homebox
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

start_service() {
	config_load homebox
	config_foreach start_instance homebox
}

service_triggers() {
	procd_add_reload_trigger "homebox"
}
